"""**Question 3: Using a for while loop, print the first 10 multiples of 7 and, at the end, display their sum.**"""

i = 0
total = 0

while i<=10:
  multiple = 7 * i
  print(multiple)
  total += multiple
  i += 1

print("Sum: ", total)

"""**Question 4: Write a function max_of_three(a,b,c) that returns the largerst of 3 numbers using only if statements. Test it with 3 different sets of values.**"""

def max_of_three(a, b, c):
    if a >= b and a >= c:
        return a
    if b >= a and b >= c:
        return b
    if c >= a and c >= b:
        return c

print(max_of_three(10, 25, 15))
print(max_of_three(50, 20, 30))
print(max_of_three(200, 120, 60))
